{
    "manifest_version": 3,
    "name": "New Clerk Extension",
    "version": "1.0",
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "file:///*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "prospero-context.js",
                "@DEV/dev-prospero-data.json",
                "@DEV/dev-prospero-routeGroups.json",
                "@DEV/dev-prospero-trailers.json",
                "thermoking-context.js",
                "@DEV/dev-thermoking-data.json"
            ],
            "matches": [
                "https://web.prospero.com/*",
		        "https://www.tracking.thermoking.com/*",
                "file:///*"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "https://web.prospero.com/hyvee/outbound/trip",
                "file:///*/@DEV/prospero.html"
            ],
            "js": [
                "prospero.js"
            ]
        },
        {
            "matches": [
                "*://*/YardViewer/LocateTrailer.aspx",
                "file:///*/@DEV/locateTrailer.html"
            ],
            "js": [
                "yard.js"
            ]
        },
        {
            "matches": [
                "https://www.tracking.thermoking.com/Combo/v2/navigateToTrackAndTrace",
                "file:///*/@DEV/thermoking.html"
            ],
            "js": [
                "thermoking.js"
            ]
        }
    ]
}